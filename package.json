{
	"name": "bible-search-modal",
	"version": "1.0.0",
	"description": "Obsidian plugin for searching Bible verses with bilingual support (KJV + RST)",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [
		"bible",
		"scripture",
		"search",
		"KJV",
		"RST",
		"bilingual"
	],
	"license": "0-BSD",
	"dependencies": {
		"sql.js": "^1.8.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"@types/sql.js": "^1.4.11",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
